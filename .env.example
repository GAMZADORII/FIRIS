# ==================================================
# FIRIS 환경변수 예시 파일
# ==================================================
# 이 파일에는 실제 비밀번호나 Secret을 작성하지 않습니다.
# 실제 실행 시에는 .env.example을 참고하여 .env 파일을 만든 뒤 값을 입력합니다.
#
# Backend / AI를 각각 단독 실행하는 경우
# backend/.env, ai/.env 설정도 각각 확인해야 합니다.
#
# 최상위 .env는 주로 Docker Compose 통합 실행 시 사용합니다.


# ==================================================
# 인증 / 보안 설정
# ==================================================

# JWT 토큰 서명에 사용할 Secret Key
# 실제 .env에서는 충분히 길고 예측하기 어려운 문자열을 사용합니다.
# 예: 32자 이상의 랜덤 문자열
JWT_SECRET=FIRIS_2026_jwt_9Kp2vL7xQ4mN8sT1zW6cR3yH5uE0aB7d

# AI Server → Backend 요청 인증에 사용할 API Key
# Backend와 AI가 반드시 동일한 값을 사용해야 합니다.
AI_API_KEY=FIRIS_AI_4fK8mP2qX9vL6sN1cT7wR3yH5uD0aZ8b


# ==================================================
# MySQL 설정
# ==================================================

# 로컬에서 Backend를 직접 실행할 때 사용할 MySQL 주소
# Docker Compose에서는 docker-compose.yml에서 mysql 컨테이너 주소로 변경될 수 있습니다.
DB_URL=jdbc:mysql://localhost:3306/firis?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# MySQL 사용자 계정
DB_USERNAME=root

# MySQL 비밀번호
# 실제 로컬 MySQL root 비밀번호를 입력합니다.
DB_PASSWORD=1234


# ==================================================
# 초기 관리자 계정
# ==================================================

# 서버 최초 실행 시 생성할 관리자 로그인 ID
ADMIN_LOGIN_ID=admin

# 초기 관리자 비밀번호
# 실제 .env에서 사용할 관리자 비밀번호를 입력합니다.
# 코드나 .env.example에는 실제 비밀번호를 작성하지 않습니다.
ADMIN_PASSWORD=admin1234

# 초기 관리자 이름
ADMIN_NAME=관리자


# ==================================================
# 작업자 계정 설정
# ==================================================

# 관리자가 작업자를 생성하거나 비밀번호를 초기화할 때 사용할 임시 비밀번호
# 실제 .env에서 팀에서 정한 임시 비밀번호를 입력합니다.
WORKER_DEFAULT_PASSWORD=qwe123

# 작업자 최초 연락처 동의 문안 버전 (프론트에 표시하는 확정 문안과 일치)
CONTACT_CONSENT_VERSION=v1

# 119 모의서버 연동 (Docker에서는 서비스 이름으로 설정)
MOCK_119_WS_URL=
MOCK_119_API_KEY=


# ==================================================
# CCTV / Backend 설정
# ==================================================

# CCTV 영상 접근에 사용할 Backend 기본 주소
# CameraInitializer에서 기본 CCTV streamUrl 생성 시 사용합니다.
# 로컬 실행 기준 주소입니다.
CAMERA_BASE_URL=http://localhost:8080


# ==================================================
# AI Server 설정
# ==================================================

# AI Server가 이벤트를 전달할 Backend 주소
# 로컬 실행 기준 주소입니다.
BACKEND_URL=http://localhost:8080

# YOLO 등 AI 모델 파일이 저장된 경로
# 실제 모델 경로가 필요한 경우 입력합니다.
# 예: ./ai/model
AI_MODELS_DIR=


# ==================================================
# 공통 Storage 경로
# ==================================================

# 확정된 화재 이벤트의 Snapshot / 영상 / JSON 저장 위치
EVENT_STORAGE_DIR=./storage/events

# CCTV별 최신 YOLO 분석 JPEG 저장 위치
# 예: CAM001.jpg, CAM002.jpg
LIVE_FRAME_DIR=./storage/live

# AI가 분석할 CCTV 영상 파일 저장 위치
# 예: storage/videos/CAM001/001.mp4
VIDEO_STORAGE_DIR=./storage/videos


# ==================================================
# Frontend 설정
# ==================================================

# Frontend에서 호출할 Backend API 주소
# VITE_로 시작하는 값은 브라우저에 노출될 수 있으므로
# 비밀번호, API Key, Secret 같은 민감정보를 넣으면 안 됩니다.
VITE_API_BASE_URL=http://localhost:8080
