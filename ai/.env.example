# ==================================================
# FIRIS AI Server 환경변수 예시 파일
# ==================================================
# 이 파일에는 실제 API Key나 Secret을 작성하지 않습니다.
# AI Server를 로컬에서 실행할 때 이 파일을 참고하여
# ai/.env 파일을 만든 뒤 실제 값을 입력합니다.


# ==================================================
# Backend 연동 설정
# ==================================================

# AI Server가 화재 탐지 이벤트를 전달할 Backend 주소
BACKEND_URL=http://localhost:8080

# AI Server → Backend 요청 인증에 사용할 API Key
# backend/.env의 AI_API_KEY와 반드시 동일한 값을 사용해야 합니다.
AI_API_KEY=


# ==================================================
# AI 모델 설정
# ==================================================

# YOLO 등 AI 모델 파일이 저장된 경로
# ai 폴더 기준 model 폴더를 사용합니다.
AI_MODELS_DIR=./model


# ==================================================
# 공통 Storage 경로
# ==================================================

# 확정된 화재 이벤트의
# Snapshot / event.mp4 / event_annotated.mp4 / event.json 저장 위치
EVENT_STORAGE_DIR=../storage/events

# CCTV별 최신 YOLO 분석 JPEG 저장 위치
#
# 예:
# ../storage/live/CAM001.jpg
# ../storage/live/CAM002.jpg
LIVE_FRAME_DIR=../storage/live

# multi_camera_service가 분석할 CCTV 영상 폴더
#
# 예:
# ../storage/videos/CAM001/001.mp4
# ../storage/videos/CAM001/002.mp4
# ../storage/videos/CAM002/001.mp4
VIDEO_STORAGE_DIR=../storage/videos