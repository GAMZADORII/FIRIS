# ==================================================
# FIRIS Backend 환경변수 예시 파일
# ==================================================
# 이 파일에는 실제 비밀번호나 Secret을 작성하지 않습니다.
# Backend를 로컬에서 실행할 때 이 파일을 참고하여
# backend/.env 파일을 만든 뒤 실제 값을 입력합니다.


# ==================================================
# 인증 / 보안 설정
# ==================================================

# JWT Access Token 서명에 사용할 Secret Key
# 실제 .env에서는 충분히 길고 예측하기 어려운 문자열을 사용합니다.
# 최소 32자 이상의 랜덤 문자열 사용을 권장합니다.
JWT_SECRET=

# JWT Access Token 만료 시간(초)
# 3600 = 1시간
JWT_EXPIRATION_SECONDS=3600

# AI Server가 Backend의 AI 전용 API를 호출할 때 사용할 인증 Key
# ai/.env의 AI_API_KEY와 반드시 동일한 값을 사용해야 합니다.
AI_API_KEY=


# ==================================================
# MySQL 설정
# ==================================================

# Backend가 접속할 MySQL 주소
# 로컬에서 Backend를 직접 실행하는 기준입니다.
DB_URL=jdbc:mysql://localhost:3306/firis?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# MySQL 사용자 계정
DB_USERNAME=root

# MySQL 비밀번호
# 실제 로컬 MySQL 비밀번호를 입력합니다.
DB_PASSWORD=

# JPA 테이블 자동 반영 방식
# 개발 환경에서는 update를 사용합니다.
DDL_AUTO=update


# ==================================================
# 초기 관리자 계정
# ==================================================

# 서버 최초 실행 시 생성할 관리자 로그인 ID
ADMIN_LOGIN_ID=admin

# 초기 관리자 비밀번호
# 실제 .env에서 사용할 관리자 비밀번호를 입력합니다.
ADMIN_PASSWORD=

# 초기 관리자 이름
ADMIN_NAME=관리자


# ==================================================
# 작업자 계정 설정
# ==================================================

# 관리자가 작업자를 생성하거나
# 작업자 비밀번호를 초기화할 때 사용할 임시 비밀번호
WORKER_DEFAULT_PASSWORD=


# ==================================================
# AI Server 연동 설정
# ==================================================

# Backend에서 AI Server를 호출할 주소
# 로컬에서 AI Server를 8000 포트로 실행하는 기준입니다.
AI_SERVER_URL=http://127.0.0.1:8000


# ==================================================
# 공통 Storage 경로
# ==================================================

# Backend가 CCTV 원본 영상 파일을 읽을 경로
# backend 폴더 기준으로 최상위 storage/videos를 가리킵니다.
CAMERA_VIDEO_DIRECTORY=../storage/videos

# Backend가 이벤트 Snapshot / 영상을 읽을 경로
# AI의 EVENT_STORAGE_DIR과 동일한 실제 폴더를 가리켜야 합니다.
EVENT_STORAGE_DIR=../storage/events