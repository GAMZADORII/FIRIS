# ==================================================
# FIRIS Backend 환경변수 예시 파일
# ==================================================
# Backend를 로컬에서 실행할 때 사용하는 환경변수입니다.


# ==================================================
# 인증 / 보안 설정
# ==================================================

# JWT Access Token 서명에 사용할 Secret Key
JWT_SECRET=FIRIS_2026_jwt_9Kp2vL7xQ4mN8sT1zW6cR3yH5uE0aB7d

# JWT Access Token 만료 시간(초)
# 3600 = 1시간
JWT_EXPIRATION_SECONDS=3600

# AI Server → Backend 요청 인증에 사용할 API Key
# ai/.env의 AI_API_KEY와 동일한 값을 사용합니다.
AI_API_KEY=FIRIS_AI_4fK8mP2qX9vL6sN1cT7wR3yH5uD0aZ8b


# ==================================================
# MySQL 설정
# ==================================================

# Backend가 접속할 MySQL 주소
DB_URL=jdbc:mysql://localhost:3306/firis?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# MySQL 사용자 계정
DB_USERNAME=root

# MySQL 비밀번호
DB_PASSWORD=1234

# JPA 테이블 자동 반영 방식 테스트용으로 craet로 바꿈 / 실제 실행 시 update 변경해야함 
DDL_AUTO=creat


# ==================================================
# 초기 관리자 계정
# ==================================================

# 서버 최초 실행 시 생성할 관리자 로그인 ID
ADMIN_LOGIN_ID=admin

# 초기 관리자 비밀번호
ADMIN_PASSWORD=admin1234

# 초기 관리자 이름
ADMIN_NAME=관리자


# ==================================================
# 작업자 계정 설정
# ==================================================

# 작업자 생성 및 비밀번호 초기화 시 사용할 임시 비밀번호
WORKER_DEFAULT_PASSWORD=qwe123


# ==================================================
# AI Server 연동 설정
# ==================================================

# Backend에서 AI Server를 호출할 주소
AI_SERVER_URL=http://127.0.0.1:8000


# ==================================================
# CCTV / Backend 설정
# ==================================================

# CCTV 영상 접근에 사용할 Backend 기본 주소
# 기본 CCTV 자동 등록 시 streamUrl 생성에 사용합니다.
CAMERA_BASE_URL=http://localhost:8080


# ==================================================
# 공통 Storage 경로
# ==================================================

# Backend가 CCTV 원본 영상 파일을 읽을 경로
# backend 폴더에서 실행하므로 ../storage/videos
CAMERA_VIDEO_DIRECTORY=../storage/videos

# Backend가 이벤트 Snapshot / 영상을 읽을 경로
# AI의 EVENT_STORAGE_DIR과 같은 실제 폴더를 가리켜야 합니다.
EVENT_STORAGE_DIR=../storage/events